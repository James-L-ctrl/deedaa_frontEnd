# DeaWeb Frontend Environment Variables
# Copy to .env and fill in your values
# DO NOT commit .env to version control!

# Backend API base URL
# Local development: leave empty (proxied via vite.config.ts to localhost:3001)
# Production (Vercel): set to your Render backend URL, e.g. https://deedaa-backend.onrender.com
VITE_API_URL=
